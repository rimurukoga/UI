    local tabs = {}
    local tabButtons = {}
    local isFirstTab = true

    local function SwitchTab(tabName)
        for name, page in pairs(tabs) do
            page.Visible = (name == tabName)
        end
        for name, btn in pairs(tabButtons) do
            local isCurrent = (name == tabName)
            local bar = btn:FindFirstChild("Indicator")
            local label = btn:FindFirstChild("Label")
            if bar then bar.Visible = isCurrent end
            if label then
                label.TextColor3 = isCurrent and Color3.fromRGB(20, 20, 20) or Color3.fromRGB(140, 145, 155)
                label.Font = isCurrent and Enum.Font.GothamBold or Enum.Font.GothamMedium
            end
        end
    end

    function Window:CreateTab(name)
        local Tab = {}
        local isDefault = isFirstTab
        isFirstTab = false

        local TabBtn = Instance.new("TextButton")
        TabBtn.Name = name .. "Tab"
        TabBtn.Size = UDim2.new(1, 0, 0, 34)
        TabBtn.BackgroundTransparency = 1
