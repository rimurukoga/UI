        TabBtn.Parent = Sidebar

        local Indicator = Instance.new("Frame")
        Indicator.Name = "Indicator"
        Indicator.Size = UDim2.new(0, 3, 0, 16)
        Indicator.Position = UDim2.new(0, 6, 0.5, -8)
        Indicator.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        Indicator.BorderSizePixel = 0
        Indicator.Visible = isDefault
        Indicator.Parent = TabBtn

        local IndCorner = Instance.new("UICorner")
        IndCorner.CornerRadius = UDim.new(1, 0)
        IndCorner.Parent = Indicator

        local Label = Instance.new("TextLabel")
        Label.Name = "Label"
        Label.Size = UDim2.new(1, -24, 1, 0)
        Label.Position = UDim2.new(0, 18, 0, 0)
        Label.BackgroundTransparency = 1
        Label.Text = name
        Label.TextColor3 = isDefault and Color3.fromRGB(20, 20, 20) or Color3.fromRGB(140, 145, 155)
        Label.TextSize = 13
        Label.Font = isDefault and Enum.Font.GothamBold or Enum.Font.GothamMedium
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.Parent = TabBtn

        local Page = Instance.new("ScrollingFrame")
        Page.Name = name .. "Page"
        Page.Size = UDim2.new(1, 0, 1, 0)
